[Unit]
Description=Read-only VNC mirror of the actual Stage kiosk
After=bosun-kiosk.service bosun-outputs.service
Requires=bosun-kiosk.service bosun-outputs.service
PartOf=bosun-kiosk.service

[Service]
Type=simple
User=bosun
# The kiosk alone owns its runtime directory; stopping VNC must not remove it.
Environment=XDG_RUNTIME_DIR=/run/bosun-kiosk
ExecStart=/opt/bosun-hub/kiosk/bosun-wayvnc.sh
KillMode=control-group
TimeoutStopSec=10s
Restart=always
RestartSec=3

[Install]
WantedBy=bosun-kiosk.service
