        <mxCell id="title" value="BOSUN / Hardware connections" style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#172B3A;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
