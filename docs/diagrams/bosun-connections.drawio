        <mxCell id="r-note" value="MIDI and Stage start automatically - works without a phone, PC, router or Internet.&#10;The display is optional; Android, Desktop and browsers connect over the network (page 2)." style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#536779;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
