        <mxCell id="subtitle" value="Three alternative setups - The Captain USB cable carries MIDI and Bosun data; the Player uses MIDI for commands and feedback." style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#536779;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
