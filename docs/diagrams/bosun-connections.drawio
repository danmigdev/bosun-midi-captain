        <mxCell id="a-note" value="Bridge ON - keep Bosun running.&#10;Use a powered hub if needed.&#10;A USB hub alone is not a MIDI bridge.&#10;Alternative: Bosun Desktop,&#10;with direct USB ports or a hub." style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#536779;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
