        </mxCell>
        <mxCell id="title" value="BOSUN / Android, Desktop and network" style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#172B3A;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="30" width="1504" height="42" />
        </mxCell>
        <mxCell id="subtitle" value="Three ways to connect the apps to the Captain. The Player is optional for editing alone; to play, use the wiring on page 1." style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#536779;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="82" width="1504" height="44" />
        </mxCell>
        <mxCell id="usb-title" value="01  Direct USB - select USB in the app" style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontStyle=1;fontColor=#172B3A;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="158" width="1460" height="32" />
        </mxCell>
        <mxCell id="u-captain" value="MIDI Captain&#10;USB-B" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#172B3A;rounded=1;arcSize=12;strokeWidth=1;strokeColor=#B4D0ED;fillColor=#EDF5FF;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="212" width="250" height="64" />
        </mxCell>
        <mxCell id="u-app" value="Bosun Android or Desktop&#10;Editor + Stage" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#172B3A;rounded=1;arcSize=12;strokeWidth=1;strokeColor=#B4D0ED;fillColor=#EDF5FF;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="636" y="212" width="360" height="64" />
        </mxCell>
        <mxCell id="u-cable-label" value="USB data cable + adapter" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#2475BC;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="344" y="208" width="280" height="26" />
        </mxCell>
        <mxCell id="u-note" value="Android: USB host/OTG + USB permissions.&#10;Desktop: USB-A or USB-C port.&#10;To play: connect the Player too&#10;and enable the MIDI bridge in the app." style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#536779;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1050" y="201" width="466" height="82" />
        </mxCell>
        <mxCell id="lan-title" value="02  Local network - Captain connected to the Pi by USB" style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontStyle=1;fontColor=#172B3A;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="344" width="1460" height="32" />
        </mxCell>
        <mxCell id="l-captain" value="MIDI Captain&#10;USB-B" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#172B3A;rounded=1;arcSize=12;strokeWidth=1;strokeColor=#B4D0ED;fillColor=#EDF5FF;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="414" width="220" height="64" />
        </mxCell>
        <mxCell id="l-pi" value="Raspberry Pi 3&#10;Bosun hub" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#172B3A;rounded=1;arcSize=12;strokeWidth=1;strokeColor=#AFD9CC;fillColor=#E9F7F1;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="434" y="414" width="220" height="64" />
        </mxCell>
        <mxCell id="l-lan" value="Existing LAN&#10;Router / switch" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#172B3A;rounded=1;arcSize=12;strokeWidth=1;strokeColor=#AFD9CC;fillColor=#E9F7F1;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="810" y="414" width="240" height="64" />
        </mxCell>
        <mxCell id="l-app" value="Bosun Android / Desktop&#10;Editor + Stage" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#172B3A;rounded=1;arcSize=12;strokeWidth=1;strokeColor=#B4D0ED;fillColor=#EDF5FF;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1220" y="414" width="300" height="64" />
        </mxCell>
        <mxCell id="l-usb-label" value="USB-B &lt;-&gt; USB-A" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#2475BC;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="304" y="408" width="124" height="26" />
        </mxCell>
        <mxCell id="l-network-label" value="Wi-Fi / Ethernet" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#168374;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="658" y="407" width="148" height="26" />
        </mxCell>
        <mxCell id="l-client-label" value="Same LAN" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#168374;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1055" y="407" width="158" height="26" />
        </mxCell>
        <mxCell id="l-note" value="Android over Wi-Fi; Desktop and Pi over Wi-Fi or Ethernet. In the apps: Raspberry Pi (network) -&gt; Find Raspberry Pi -&gt; Connect.&#10;If discovery fails: enter the Pi hostname/IP and port 9876." style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#536779;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="494" width="1440" height="44" />
        </mxCell>
        <mxCell id="hotspot-title" value="03  Pi Wi-Fi hotspot - Captain connected to the Pi by USB" style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontStyle=1;fontColor=#172B3A;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="590" width="1460" height="32" />
        </mxCell>
        <mxCell id="h-captain" value="MIDI Captain&#10;USB-B" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#172B3A;rounded=1;arcSize=12;strokeWidth=1;strokeColor=#B4D0ED;fillColor=#EDF5FF;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="660" width="220" height="64" />
        </mxCell>
        <mxCell id="h-pi" value="Raspberry Pi 3 - Wi-Fi hotspot&#10;Bosun hub - default IP 10.42.0.1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#172B3A;rounded=1;arcSize=12;strokeWidth=1;strokeColor=#AFD9CC;fillColor=#E9F7F1;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="504" y="648" width="396" height="88" />
        </mxCell>
        <mxCell id="h-app" value="Bosun Android / Desktop&#10;Join the configured Pi Wi-Fi network" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#172B3A;rounded=1;arcSize=12;strokeWidth=1;strokeColor=#B4D0ED;fillColor=#EDF5FF;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="656" width="380" height="72" />
        </mxCell>
        <mxCell id="h-usb-label" value="USB-B &lt;-&gt; USB-A" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#2475BC;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="306" y="653" width="192" height="27" />
        </mxCell>
        <mxCell id="h-wifi-label" value="Direct Wi-Fi&#10;No router / Internet needed" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#168374;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="906" y="628" width="228" height="44" />
        </mxCell>
        <mxCell id="h-note" value="In the apps: Raspberry Pi (network) -&gt; Find Raspberry Pi -&gt; Connect; default manual address: 10.42.0.1:9876.&#10;Stay on the Pi Wi-Fi even if the device reports no Internet. Desktop needs Wi-Fi; Ethernet remains available on the Pi." style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#536779;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="748" width="1440" height="44" />
        </mxCell>
        <mxCell id="browser-title" value="APPS AND BROWSERS" style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#172B3A;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="58" y="848" width="457" height="28" />
        </mxCell>
        <mxCell id="browser-body" value="Apps: full editor + Stage - port 9876&#10;Browser: Stage only - http://&lt;Pi&gt;:8080/&#10;Hotspot: http://10.42.0.1:8080/&#10;VNC: exact display mirror, read-only.&#10;Separate appearance settings per app/browser." style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#536779;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="58" y="879" width="457" height="131" />
        </mxCell>
        <mxCell id="autonomy-title" value="STANDALONE PI" style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#172B3A;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="571" y="848" width="457" height="28" />
        </mxCell>
        <mxCell id="autonomy-body" value="The Captain stays on the Pi USB port.&#10;With the Player on the Pi, the Pi handles MIDI.&#10;Closing the app leaves MIDI and HDMI Stage on.&#10;Apps, browsers and the display can coexist.&#10;Install hub and Stage; set up a hotspot if needed." style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#536779;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="571" y="879" width="457" height="131" />
        </mxCell>
        <mxCell id="limits-title" value="NATIVE FIRMWARE AND LIMITS" style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#172B3A;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1084" y="848" width="458" height="28" />
        </mxCell>
        <mxCell id="limits-body" value="Firmware updates: use Bosun Desktop.&#10;See README for supported update paths.&#10;Player Wi-Fi/Bluetooth does not connect Bosun.&#10;Android is not a network hub for the Pi.&#10;Captain USB-B: one host at a time." style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#536779;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1084" y="879" width="458" height="131" />
        </mxCell>
        <mxCell id="q-foot" value="The Android setup needs Bosun running for its MIDI bridge; in the Pi setup, the bridge runs on the Raspberry Pi." style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#536779;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="1030" width="1504" height="27" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
