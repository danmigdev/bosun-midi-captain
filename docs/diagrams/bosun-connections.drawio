          <mxGeometry as="geometry" x="350" y="194" width="160" height="40" />
        </mxCell>
        <mxCell id="d-note" value="Play with the Captain and its built-in display.&#10;To edit: move the USB cable to a Bosun host.&#10;This setup does not provide an external Stage display." style="whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#536779;text;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
