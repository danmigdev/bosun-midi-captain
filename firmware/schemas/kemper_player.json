    },
    "kemper_bpm": {
      "label": "Tempo (BPM)",
      "sample": 120
    },
    "kemper_tuner": {
      "label": "Tuner state (on/off)",
      "sample": "off"
    },
    "kemper_tuner_note": {
      "label": "Tuner note (C/Db/D/.../B)",
      "sample": "A"
    },
    "kemper_tuner_deviance": {
      "label": "Tuner deviance (0..16383, 8192=in tune)",
      "sample": 8192
    },
    "kemper_connected": {
      "label": "Bidirectional link state (on/off)",
      "sample": "on"
    }
  },
  "config_schema": {
    "key": "kemper",
    "label": "Kemper Player target",
    "fields": {}
  }
