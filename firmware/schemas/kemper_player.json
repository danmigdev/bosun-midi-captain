    },
    "kemper_rig": {
      "label": "Current Kemper rig (1-125)",
      "sample": 23
    },
    "kemper_bank": {
      "label": "Kemper bank (1-25)",
      "sample": 5
    },
    "kemper_rig_in_bank": {
      "label": "Rig within bank (1-5)",
      "sample": 3
    },
    "kemper_rig_name": {
      "label": "Rig name (live from Kemper)",
