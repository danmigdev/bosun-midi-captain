        "toggle_off": {
          "messages": [
            {"type": "headrush_block", "block": 2, "state": "off", "channel": 1}
          ]
        }
      }
    },
    {
      "switch": "up",
      "mode": "latched",
      "label": "REV",
      "led": {"on": "#c08aff"},
      "actions": {
        "toggle_on": {
          "messages": [
            {"type": "headrush_block", "block": 4, "state": "on", "channel": 1}
