  "on_enter": {
    "messages": [
      {"type": "headrush_rig", "rig": 1, "channel": 1}
    ]
  },
  "bindings": [
    {
      "switch": "4",
      "mode": "latched",
      "label": "MOD",
      "led": {"on": "#ff8a00"},
      "actions": {
        "toggle_on": {
          "messages": [
