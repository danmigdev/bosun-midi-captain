      }
    },
    {
      "switch": "up",
      "mode": "latched",
      "label": "DLY",
      "led": {"on": "#00bcd4"},
      "actions": {
        "toggle_on": {
          "messages": [
            {"type": "headrush_block", "block": 3, "state": "on", "channel": 1}
          ]
        },
        "toggle_off": {
          "messages": [
            {"type": "headrush_block", "block": 3, "state": "off", "channel": 1}
          ]
        }
      }
    }
  ]
